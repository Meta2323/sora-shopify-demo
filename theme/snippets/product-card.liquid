<article class="product-card"><a href="{{ card_product.url }}">{% if card_product.featured_image %}{{ card_product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', class: 'product-image' }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'product-image placeholder' }}{% endif %}<div class="card-info"><h3>{{ card_product.title | escape }}</h3><span>{{ card_product.price | money }}</span></div></a></article>
