<section class="hero"><div class="hero-copy"><p class="eyebrow">THE ART OF GIVING</p><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.text | escape }}</p><a class="button" href="{{ routes.all_products_collection_url }}">Explore the collection <span aria-hidden="true">↗</span></a><p class="note">Considered details. Meaningful moments.</p></div><div class="hero-art"><img src="{{ 'gift.svg' | asset_url }}" width="800" height="700" alt="Illustrated gift box with ribbon" class="gift-image" loading="eager"><div class="art-note">THE SIGNATURE EDIT<br><em>Made for your meaningful moments.</em></div></div></section>
{% schema %}
{"name": "Hero", "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "Small gestures. Beautifully considered."}, {"type": "text", "id": "text", "label": "Description", "default": "A collection of thoughtful gifts for the people who make your everyday extraordinary."}], "presets": [{"name": "Hero"}]}
{% endschema %}
