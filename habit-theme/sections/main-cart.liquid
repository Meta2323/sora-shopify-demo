<section class="collection-section cart-page"><p class="eyebrow">READY TO GIVE</p><h1>Your bag</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div class="cart-row"><a href="{{ item.url }}">{{ item.product.title | escape }}<small>{{ item.variant.title | escape }}</small></a><div>{% for property in item.properties %}{% assign first_character = property.first | slice: 0 %}{% if property.last != blank and first_character != '_' %}<p>{{ property.first | escape }}: {{ property.last | escape }}</p>{% endif %}{% endfor %}</div><label>Quantity<input name="updates[]" type="number" min="0" value="{{ item.quantity }}" aria-label="Quantity for {{ item.product.title | escape }}"></label><span>{{ item.final_line_price | money }}</span><a href="{{ item.url_to_remove }}">Remove</a></div>{% endfor %}<label for="note">Order note</label><textarea name="note" id="note" rows="3">{{ cart.note | escape }}</textarea><h2>Total: {{ cart.total_price | money }}</h2><p>Shipping and taxes calculated at checkout.</p><button class="button secondary" name="update" type="submit">Update bag</button><button class="button" name="checkout" type="submit">Checkout</button></form>{% else %}<p>Your bag is waiting for something lovely.</p><a class="button" href="{{ routes.all_products_collection_url }}">Explore gifts</a>{% endif %}</section>
{% schema %}
{"name": "Main Cart", "settings": [], "presets": [{"name": "Main Cart"}]}
{% endschema %}
