<section class="collection-section"><div class="section-heading"><div><p class="eyebrow">CURATED WITH CARE</p><h2>{{ section.settings.heading | escape }}</h2></div><a href="{{ routes.all_products_collection_url }}">View all gifts ↗</a></div><div class="grid">{% for item in section.settings.collection.products limit: 3 %}{% render 'product-card', card_product: item %}{% else %}{% for i in (1..3) %}<article class="product-card">{{ 'product-1' | placeholder_svg_tag: 'product-image placeholder' }}<h3>Add demo products in Shopify</h3></article>{% endfor %}{% endfor %}</div></section><section class="story" id="story"><p class="eyebrow">LESS, BUT MORE MEANINGFUL</p><h2>A gift that feels<br>like you thought of everything.</h2><p>Objects to keep. Flavours to savour. A note to remember.<br>Every detail has its place.</p></section>
{% schema %}
{"name": "Featured", "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "Find their kind of lovely."}, {"type": "collection", "id": "collection", "label": "Featured collection"}], "presets": [{"name": "Featured"}]}
{% endschema %}
