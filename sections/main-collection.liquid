<section class="collection-section"><p class="eyebrow">THE COLLECTION</p><h1>{{ collection.title | escape }}</h1><div class="collection-description">{{ collection.description }}</div><form method="get"><label for="sort">Sort by</label><select name="sort_by" id="sort" onchange="this.form.submit()">{% assign current_sort = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value | escape }}" {% if option.value == current_sort %}selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select><noscript><button>Sort</button></noscript></form>{% paginate collection.products by 12 %}<div class="grid">{% for item in collection.products %}{% render 'product-card', card_product: item %}{% else %}<p>No gifts in this collection yet.</p>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}</section>
{% schema %}
{"name": "Main Collection", "settings": [], "presets": [{"name": "Main Collection"}]}
{% endschema %}
