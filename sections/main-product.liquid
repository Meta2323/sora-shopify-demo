{% assign chosen = product.selected_or_first_available_variant %}<section class="product-page"><div>{% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 | image_tag: class: 'detail-image', loading: 'eager' }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'detail-image placeholder' }}{% endif %}</div><div class="product-copy"><p class="eyebrow">THE SIGNATURE COLLECTION</p><h1>{{ product.title | escape }}</h1><p class="price" data-variant-price>{{ chosen.price | money }}</p><div class="description">{{ product.description }}</div>{% form 'product', product %}<label for="variant-{{ section.id }}">Choose your gift</label><select id="variant-{{ section.id }}" name="id" data-variant-select>{% for variant in product.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price | money | escape }}" data-available="{{ variant.available }}" {% if variant.id == chosen.id %}selected{% endif %}>{{ variant.title | escape }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select><label for="quantity-{{ section.id }}">Quantity</label><input id="quantity-{{ section.id }}" name="quantity" type="number" min="1" value="1" required><label for="message-{{ section.id }}">Gift message (optional)</label><textarea id="message-{{ section.id }}" name="properties[Gift message]" maxlength="240" rows="3" placeholder="A few words, just for them."></textarea><button class="button" type="submit" data-add-button {% unless chosen.available %}disabled{% endunless %}>{% if chosen.available %}Add to bag{% else %}Sold out{% endif %}</button>{{ form.errors | default_errors }}{% endform %}<p class="note">Shipping and taxes calculated at checkout.{% if cart.taxes_included %} Taxes included.{% endif %}</p><details><summary>Gifting details</summary><p>Gift messages are saved with your selected item. Product contents and availability depend on the selected variant.</p></details></div></section>
{% schema %}
{"name": "Main Product", "settings": [], "presets": [{"name": "Main Product"}]}
{% endschema %}
